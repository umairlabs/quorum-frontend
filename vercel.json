{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "www",
  "framework": "angular",
  "env": {
    "NG_APP_API_URL": "https://quorum-backend.onrender.com"
  },
  "routes": [
    {
      "src": "^/(?!.*\\.).*$",
      "dest": "/index.html",
      "status": 200
    },
    {
      "src": "/.*",
      "status": 404
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.*\\.(js|css|ico|png|jpg|jpeg|svg|webp|woff|woff2)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
